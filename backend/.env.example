# ============================================================================
# .env.example — Contoh konfigurasi TANGGAP Backend.
#
# CARA PAKAI:
#   1. Salin file ini menjadi `.env`:
#        cp .env.example .env
#   2. Ubah nilainya sesuai kebutuhan.
#   3. File `.env` JANGAN di-commit ke git (sudah ada di .gitignore) karena
#      berisi rahasia (JWT_SECRET).
#
# Kalau file `.env` tidak ada, aplikasi tetap jalan memakai nilai default
# dari src/config.js — jadi file ini opsional untuk belajar.
# ============================================================================

# Port backend (default 3001)
PORT=3001

# Host: 127.0.0.1 = hanya dari laptop sendiri.
# Ubah ke 0.0.0.0 kalau mau diakses dari HP di WiFi yang sama.
HOST=127.0.0.1

# Kunci rahasia JWT — WAJIB diganti dengan string acak yang panjang kalau
# aplikasi dipakai sungguhan. Kalau bocor, orang bisa memalsukan token login!
JWT_SECRET=tanggap-belajar-rahasia-jangan-dipakai-produksi

# Masa berlaku token login (8 jam)
JWT_EXPIRES_IN=8h

# Lokasi file database SQLite (default: backend/data/tanggap.db)
# DB_PATH=/lokasi/lain/tanggap.db
